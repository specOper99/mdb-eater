<Window
    x:Class="MdbConverter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MdbConverter.App"
    Title="MDB Converter">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="MDB Converter" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Offline export of any Access .mdb to JSON and postgres.sql. No network." Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <InfoBadge Value="1"/>
            <TextBlock x:Name="StepLabel" VerticalAlignment="Center" Text="Source"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="SourcePanel" Visibility="Visible">
                <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="Access database" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MdbPathBox" PlaceholderText="Select a .mdb file" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowseMdb_Click"/>
                    </Grid>
                    <PasswordBox x:Name="DbPasswordBox" Header="Database password (optional)" PlaceholderText="Leave blank if none"/>
                    <Expander Header="Workgroup security (.mdw)" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MdwPathBox" PlaceholderText="Select a .mdw file" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse" Click="BrowseMdw_Click"/>
                            </Grid>
                            <TextBox x:Name="WorkgroupUserBox" Header="User" PlaceholderText="admin"/>
                            <PasswordBox x:Name="WorkgroupPasswordBox" Header="Password"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="SourceError" Foreground="Red" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="ObjectsPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Select all" Click="SelectAll_Click"/>
                    <Button Content="Select none" Click="SelectNone_Click"/>
                    <TextBlock x:Name="ObjectCountLabel" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="ObjectList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SelectableObject">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind KindLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind Badge}" Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="ExportPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderBox" Header="Output folder" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="BrowseOutput_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="WriteJsonBox" Content="JSON / JSONL" IsChecked="True"/>
                        <CheckBox x:Name="WriteSqlBox" Content="postgres.sql" IsChecked="True"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="If a PostgreSQL table already exists when the script is applied"/>
                        <RadioButtons x:Name="ConflictButtons" MaxColumns="2" SelectionChanged="ConflictButtons_SelectionChanged">
                            <RadioButton Content="Replace" Tag="Replace" IsChecked="True"/>
                            <RadioButton Content="Skip" Tag="Skip"/>
                        </RadioButtons>
                    </StackPanel>
                    <ProgressBar x:Name="ExportProgress" IsIndeterminate="True" Visibility="Collapsed"/>
                    <TextBlock x:Name="ExportStatus" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <TextBlock x:Name="LogBlock" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" IsEnabled="False"/>
            <Button x:Name="NextButton" Grid.Column="1" Content="Scan" Click="Next_Click" Margin="0,0,8,0"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export" Click="Export_Click" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
